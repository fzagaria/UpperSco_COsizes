   u = The triangular field in Upper Sco from 
       Luhman & Esplin (2020) [2020AJ....160...44L], excluding Ophiuchus;
   l = The fields encompassing Lupus clouds 1-4 from 
       Luhman (2020) [2020AJ....160..186L]; 
